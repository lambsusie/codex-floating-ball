{
  "name": "codex-floating-ball",
  "version": "1.1.2",
  "description": "A customizable Windows and macOS floating widget for monitoring local Codex usage quota.",
  "main": "src/main/main.js",
  "author": "lambsusie and contributors",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/lambsusie/codex-floating-ball",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambsusie/codex-floating-ball.git"
  },
  "bugs": {
    "url": "https://github.com/lambsusie/codex-floating-ball/issues"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test",
    "test:visual": "electron scripts/visual-smoke-main.js",
    "test:compact-edge": "electron scripts/compact-edge-smoke-main.js",
    "test:detail-surface": "electron scripts/detail-surface-smoke-main.js",
    "build": "npm run build:win",
    "build:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable",
    "build:mac": "npm run build:mac:arm64 && npm run build:mac:x64",
    "build:mac:arm64": "electron-builder --mac dmg --arm64 --publish never",
    "build:mac:x64": "electron-builder --mac dmg --x64 --publish never",
    "build:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "io.github.lambsusie.codexfloatingball",
    "productName": "Codex Floating Ball",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Codex-Floating-Ball-${version}-win-x64.exe"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Codex-Floating-Ball-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
